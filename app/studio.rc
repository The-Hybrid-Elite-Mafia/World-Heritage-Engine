// World Heritage Engine — window icon, manifest, version info.
#include <windows.h>

1 ICON "res/whe.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "studio.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Hybrid Elite Mafia"
      VALUE "FileDescription", "World Heritage Engine"
      VALUE "FileVersion", "0.2.0"
      VALUE "ProductName", "World Heritage Engine"
      VALUE "ProductVersion", "0.2.0"
      VALUE "LegalCopyright", "GPLv3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
